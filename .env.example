# URL del WebSocket del BACKEND. Los rewrites de Next.js sólo proxean HTTP:
# NO reenvían el upgrade a WebSocket, así que el navegador debe conectar
# directamente al backend.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
# Puerto del backend (usado si NEXT_PUBLIC_WS_URL no está definido).
NEXT_PUBLIC_API_PORT=8000
# Backend para el proxy HTTP de Next.
API_INTERNAL_URL=http://127.0.0.1:8000
